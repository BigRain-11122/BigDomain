# Evidence files are byte-exact products: the writer census classifies them by
# their on-disk dialect (utf-8, no BOM, bare LF), so git must never convert
# their line endings. Born at R2530 after core.autocrlf=true rewrote two
# repaired evidence logs towards CRLF on the next touch.
qa/*.log -text

# The commit-side freeze gate is executed by sh, which would read a CR before
# the first newline as part of the interpreter path. Pinned to LF so a checkout
# on an autocrlf host cannot silently disable the gate. Born at R2840.
tools/hooks/pre-commit text eol=lf

# Queue files are written with bare LF by their per-round writers and their
# readers report lf_only, so core.autocrlf=true must not reintroduce CRLF on
# checkout. Born at R2548: the seed writer read lf_only=False straight after a
# git checkout of the same file, which is churn no reader can distinguish from
# a real edit.
state/queue/*.md text eol=lf

# The suite matrix is machine-regenerated every window by suite_matrix.py, which
# writes bare LF. Without a pin a checkout hands it back as CRLF, so the next
# --check compares CRLF on disk against regenerated LF and reports a mismatch
# that is pure dialect. Pinned to LF so a diff shows content only. CORRECTION:
# an earlier version of this comment claimed a 491/491 R2548 diff was that
# dialect churn - it was not, it was 491 genuine per-suite timing cells.
docs/sandbox-suite-matrix.md text eol=lf

# src/os/state.json is read by both fold doors and by the closeout gate in its
# canonical dialect: CRLF separators, sixteen-space log items. This path was
# NOT pinned before R3208, and a blob is always stored as LF, so any checkout
# running with core.autocrlf=false materialized the WHOLE carrier as bare LF -
# exactly the drift the closeout gate refused twice (R3204 bare_lf=49, R3207
# bare_lf=70) and each time repaired by hand through
# `python src/os/logs_toolkit.py eol --fix --execute`. Measured at R3208 in a
# private repo: add under autocrlf=true then checkout under autocrlf=false
# landed bytes=59808 crlf=0 bare_lf=78, while the same cycle with this pin
# landed bytes=59886 crlf=78 bare_lf=0, and the pin held for all three
# add/checkout combinations. The carrier dialect is a property of the FILE,
# never of the machine's git settings. Born at R3208.
src/os/state.json text eol=crlf