# BigDomain — product repo local exclusions
# runtime artifacts from the OS loop (src/os/iteration_loop.ps1 writes logs/)
logs/
*.log
# QA smoke evidence (group QA Smoke Test charter v1.0, orders L254 2026-09-28): the group
# reviews each repo's qa/ dir for a fresh screenshot + log, keep them tracked despite *.log.
!qa/*.log
__pycache__/
*.pyc
# secrets (account domain = CEO physical items; keys never enter git)
.env
.env.*
# codely runtime
.codely-cli/scheduled_tasks.json
.codely-cli/auto-saves/
.codely-cli/skills/
# sandbox runtime artifacts (src/sandbox/lobby: venv, sqlite db, jsonl export)
src/sandbox/lobby/.venv/
src/sandbox/lobby/data/
# sandbox runtime artifacts (src/sandbox/ugc: sqlite db, acceptance-test exports;
# the real export/ reflux dir stays tracked - it is the git read-only channel)
src/sandbox/ugc/data/
src/sandbox/ugc/export-ac-*/
# sandbox runtime artifacts (src/sandbox/pay: sqlite dbs from CLI readiness runs)
src/sandbox/pay/data/
# sandbox runtime artifacts (src/sandbox/member: sqlite dbs from CLI readiness runs)
src/sandbox/member/data/
